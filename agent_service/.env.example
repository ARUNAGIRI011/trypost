# CrewAI + NVIDIA Nemotron marketing agent
APP_ENV=development
AGENT_API_KEY=replace-with-a-long-random-secret
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Same PostgreSQL database used by TryPost. Supabase Free: use direct connection
# when host supports IPv6; otherwise use shared pooler SESSION mode on port 5432.
DATABASE_URL=postgresql+psycopg://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres

# TryPost self-hosted URL and workspace API key (Settings -> API Keys).
TRYPOST_API_BASE_URL=http://trypost-app/api
TRYPOST_API_KEY=
REQUEST_TIMEOUT_SECONDS=30
